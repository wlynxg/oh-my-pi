{
  "name": "personal-pi-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi workflow skills with adaptive execution and upstream tracking",
  "keywords": [
    "pi-package",
    "skills",
    "workflow"
  ],
  "pi": {
    "extensions": [
      "./extensions/skills-status.js",
      "./extensions/fast-mode.js",
      "./extensions/codex-accounts.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "sync": "node scripts/sync-skills.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:fast-mode": "node --test scripts/test-fast-mode.mjs",
    "test:accounts": "node --test scripts/test-codex-accounts.mjs",
    "test:opencode-usage": "node --test scripts/test-opencode-usage.mjs"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
